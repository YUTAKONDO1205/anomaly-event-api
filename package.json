{
  "name": "anomaly-event-api",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless anomaly event management API on AWS",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "sam:build": "npm run build && sam build",
    "sam:local": "npm run build && sam local start-api",
    "sam:deploy": "npm run build && sam build && sam deploy --guided",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.879.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/lib-dynamodb": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
